<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Target width of a video card; actual column count is computed at runtime
         from the screen width so portrait phones and tablets both get a sensible
         grid (mirrors the intent of GridFragmentHelper's column math, but driven by
         the real current width instead of always the long screen dimension - that
         TV helper assumes landscape, which is wrong for a portrait phone). -->
    <dimen name="mobile_card_target_width">168dp</dimen>
    <dimen name="mobile_card_spacing">8dp</dimen>
    <dimen name="mobile_card_corner_radius">16dp</dimen>
    <!-- Standard phone toolbar height (actionBarSize). -->
    <dimen name="mobile_title_bar_height">64dp</dimen>
    <!-- MobileAppDialogActivity: a sheet on a wide (landscape) window stops at Material's 640dp
         and centres; its title lines up with the rows (16dp) or sits 4dp after the back arrow. -->
    <dimen name="mobile_sheet_max_width">640dp</dimen>
    <dimen name="mobile_dialog_title_inset">16dp</dimen>
    <dimen name="mobile_dialog_title_inset_with_back">4dp</dimen>

    <!-- Touch player controls -->
    <dimen name="mobile_player_center_button">64dp</dimen>
    <!-- 48dp touch target around a 24dp glyph (12dp padding); was 40dp (NEWTUBE(touch)). -->
    <dimen name="mobile_player_icon_button">48dp</dimen>
    <dimen name="mobile_player_top_scrim_height">112dp</dimen>
    <dimen name="mobile_player_bottom_scrim_height">128dp</dimen>
    <dimen name="mobile_player_time_text">13sp</dimen>
    <!-- NEWTUBE(seek bar): the seek bar's box (its touch band; the track lies on its bottom edge in
         portrait), the bottom row's margin over it (the rows overlap by 8dp: only the band's
         lower part below the row's icons scrubs) and the dragged time/chapter pill's margin. -->
    <dimen name="mobile_player_bar_height">18dp</dimen>
    <dimen name="mobile_player_bottom_row_margin">10dp</dimen>
    <dimen name="mobile_player_scrub_pill_margin">30dp</dimen>

    <!-- Watch page (portrait content under the video) -->
    <dimen name="mobile_watch_content_padding">12dp</dimen>
    <dimen name="mobile_watch_avatar_size">40dp</dimen>
    <dimen name="mobile_watch_related_thumb_width">160dp</dimen>
    <dimen name="mobile_watch_related_thumb_height">90dp</dimen>
    <!-- NEWTUBE(comments-panel): a comment's avatar; its text column starts 12dp after it. -->
    <dimen name="mobile_comment_avatar">28dp</dimen>
</resources>
