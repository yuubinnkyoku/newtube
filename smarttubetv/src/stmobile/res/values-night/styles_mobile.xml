<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NewTube" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="colorPrimaryDark">@color/mobile_color_primary_dark</item>
        <!-- NEWTUBE(m3e): complete semantic role mapping. MDC 1.14's expressive widgets read
             these roles directly (active indicators, state layers, tonal surfaces, dialogs). -->
        <item name="colorPrimary">@color/mobile_color_primary</item>
        <item name="colorOnPrimary">@color/mobile_color_on_primary</item>
        <item name="colorPrimaryContainer">@color/mobile_color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mobile_color_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/mobile_color_primary_inverse</item>
        <item name="colorPrimaryFixed">@color/mobile_color_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/mobile_color_primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/mobile_color_on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/mobile_color_on_primary_fixed_variant</item>
        <item name="colorSecondary">@color/mobile_color_secondary</item>
        <item name="colorOnSecondary">@color/mobile_color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/mobile_color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/mobile_color_on_secondary_container</item>
        <item name="colorSecondaryFixed">@color/mobile_color_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/mobile_color_secondary_fixed_dim</item>
        <item name="colorOnSecondaryFixed">@color/mobile_color_on_secondary_fixed</item>
        <item name="colorOnSecondaryFixedVariant">@color/mobile_color_on_secondary_fixed_variant</item>
        <item name="colorTertiary">@color/mobile_color_tertiary</item>
        <item name="colorOnTertiary">@color/mobile_color_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/mobile_color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/mobile_color_on_tertiary_container</item>
        <item name="colorTertiaryFixed">@color/mobile_color_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/mobile_color_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/mobile_color_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/mobile_color_on_tertiary_fixed_variant</item>
        <item name="android:colorBackground">@color/mobile_color_background</item>
        <item name="colorOnBackground">@color/mobile_color_on_surface</item>
        <item name="colorSurface">@color/mobile_color_surface</item>
        <item name="colorOnSurface">@color/mobile_color_on_surface</item>
        <item name="colorSurfaceVariant">@color/mobile_color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/mobile_color_on_surface_secondary</item>
        <item name="colorSurfaceDim">@color/mobile_color_surface_dim</item>
        <item name="colorSurfaceBright">@color/mobile_color_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/mobile_color_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/mobile_color_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/mobile_color_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/mobile_color_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/mobile_color_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/mobile_color_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/mobile_color_on_inverse_surface</item>
        <item name="colorOutline">@color/mobile_color_outline</item>
        <item name="colorOutlineVariant">@color/mobile_color_outline_variant</item>
        <item name="colorError">@color/mobile_color_error</item>
        <item name="colorOnError">@color/mobile_color_on_error</item>
        <item name="colorErrorContainer">@color/mobile_color_error_container</item>
        <item name="colorOnErrorContainer">@color/mobile_color_on_error_container</item>
        <item name="colorAccent">@color/mobile_color_primary</item>
        <item name="colorControlActivated">@color/mobile_color_primary</item>
        <item name="android:windowBackground">@color/mobile_color_background</item>
        <!-- Solid app-colored system bars from the first frame (otherwise colorPrimaryDark red
             flashes in the status bar until the runtime chrome in MobileActivity lands). -->
        <item name="android:statusBarColor">@color/mobile_color_background</item>
        <item name="android:navigationBarColor">@color/mobile_color_navigation_bar</item>
        <item name="android:windowLightStatusBar">@bool/mobile_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/mobile_light_system_bars</item>
        <!-- Edge-to-edge (transparent bars, content underneath) is forced from targetSdk 35 on,
             which no-ops the fitted opaque #0F0F0F bars painted above. This attr opts out - but
             ONLY on Android 15 and below; from Android 16 the platform ignores it and the app is
             edge-to-edge whatever this says. Verified rather than assumed, by reading the private
             window flags of the same build on two devices (dumpsys window windows, pfl= line):

               Android 15 / API 35 (Mi 8): NO_MOVE_ANIMATION FORCE_DRAW_STATUS_BAR_BACKGROUND ...
               Android 17 / API 37 (Pixel 9): NO_MOVE_ANIMATION EDGE_TO_EDGE_ENFORCED ...

             - and a neighbouring app on the SAME Android 15 device does carry
             EDGE_TO_EDGE_ENFORCED, so the flag's absence is this opt-out working, not the OS
             lacking the feature. So keep it: down at minSdk 24 it is still what separates the
             bars. What keeps modern devices right is MobileActivity.installContentInsets().
             Same split applies to statusBarColor/navigationBarColor above. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- Bottom sheets. Without this, a BottomSheetDialog falls back to Material's
             Theme.Design.Light.BottomSheetDialog - a WHITE sheet frame under our dark
             content (hence the old "paint the frame transparent" workaround), and on the
             fragment path an elevation overlay lightened the surface to #3F3F3F. Either
             way the wrong colour showed through the navigation-inset padding Material adds
             to the frame: a pale band between the sheet and the display edge. Style the
             frame properly instead - Material paints it itself, on every layout, so a
             background assigned in code never sticks. -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.NewTube.BottomSheetDialog</item>
        <item name="android:windowAnimationStyle">@style/BrowseWindowAnimation</item>
        <!-- NEWTUBE(buttons): sentence case everywhere. Material's default button text is
             ALL CAPS with 0.09em tracking ("SIGN IN", "TRY AGAIN", "CONTINUE WITH GOOGLE") and
             TabLayout reads the same attribute (channel tabs "NEW HERE? TRY THESE!"), next to
             the app's own sentence-case pills ("Play all", "Subscribe"). Changing the text
             appearance - not materialButtonStyle - keeps every button's own shape/colour. -->
        <item name="textAppearanceButton">@style/TextAppearance.NewTube.Button</item>
        <!-- NEWTUBE(snackbar): the action on the Snackbar (light on the dark theme, dark on the
             light one) in the app's ink, not red - "Sign in" / "Undo" / "View" are choices,
             not alarms. -->
        <item name="snackbarButtonStyle">@style/Widget.NewTube.Snackbar.Action</item>
    </style>

    <!-- NEWTUBE(theme): the dark theme needs no dark overlay on the player; empty on purpose, so
         the player chrome resolves exactly as it did before the light theme existed. -->
    <style name="ThemeOverlay.NewTube.PlayerChrome" parent="" />
</resources>
