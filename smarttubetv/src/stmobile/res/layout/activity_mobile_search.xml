<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Search screen (Wave 4b).

  Toolbar = back arrow + a rounded EditText (IME action = search) + a mic button for
  voice input. Below the toolbar, a horizontally-scrolling strip of tag SUGGESTION chips
  (fed live as the user types, via SearchPresenter's MediaServiceSearchTagProvider), and
  under that a single Material RecyclerView GRID of results (reuses VideoCardAdapter and
  the same runtime span-count math + onScrollEnd pagination as the Home/Channel grids).

  Drives the unchanged SearchPresenter via the standard MVP seam; this is the touch
  replacement for the Leanback SearchTagsFragment/SearchTagsActivity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/mobile_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_search_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mobile_back"
            app:icon="@drawable/ic_mobile_back_arrow"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Xsmall" />

        <!--
             M3 SearchBar geometry: the clear action lives INSIDE the field so showing it never
             changes the field width. This keeps the top bar stable while typing.
        -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/mobile_search_field_background">

            <EditText
                android:id="@+id/mobile_search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/mobile_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="52dp"
                android:singleLine="true"
                android:textColor="@color/mobile_color_on_surface"
                android:textColorHint="@color/mobile_color_on_surface_secondary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_search_clear"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@string/mobile_search_clear"
                android:visibility="gone"
                app:icon="@drawable/ic_sheet_close"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Xsmall"
                tools:visibility="visible" />

        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_search_mic"
            style="?attr/materialIconButtonFilledTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mobile_search_voice"
            app:backgroundTint="@color/mobile_m3_surface_container_high"
            app:icon="@drawable/ic_mobile_mic"
            app:iconTint="@color/mobile_color_on_surface"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Xsmall" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

        <!-- NEWTUBE(motion): results load under card ghosts (the feed's shimmering skeleton), not
             a centered spinner; only over an empty list (MobileSearchActivity.showProgressBar). -->
        <include
            layout="@layout/mobile_feed_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- A search that ends with zero rows used to just... stop (spinner gone, screen
             blank). Shown by showProgressBar(false) when the grid is empty, worded by
             SearchLoadState: no connection / couldn't load (both with Try again) / no results. -->
        <include
            android:id="@+id/mobile_search_message"
            layout="@layout/mobile_page_load_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Suggestions/history: a full-height vertical list OVER the results while the user
             is editing the query (YouTube-style; was a one-line horizontal chip strip).
             Empty query = search history (clock rows), typed query = live suggestions. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mobile_color_background"
            android:paddingTop="4dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_mobile_search_suggestion"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>

    <!-- Minimizing a video opened from these results keeps playback alive in this overlay. -->
    <include layout="@layout/mobile_mini_player_overlay" />

</FrameLayout>
