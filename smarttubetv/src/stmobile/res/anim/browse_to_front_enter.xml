<?xml version="1.0" encoding="utf-8"?>
<!-- M3E-style page entrance: compact shared-axis cue + fade/scale, not a theatrical slide. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3e_emphasized_decelerate">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="240" />
    <translate
        android:fromXDelta="2%p"
        android:toXDelta="0%p"
        android:duration="260" />
    <scale
        android:fromXScale="0.985"
        android:toXScale="1.0"
        android:fromYScale="0.985"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="260" />
</set>
