<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive navigation tint: selected destinations use the secondary role
     against the large tonal active indicator; inactive destinations recede to on-surface-variant. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/mobile_m3_secondary" />
    <item android:color="@color/mobile_m3_on_surface_variant" />
</selector>
